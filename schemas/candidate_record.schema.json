{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-VB-101/blob/main/schemas/candidate_record.schema.json",
  "title": "VB-101 Candidate Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "symbol", "evidence", "provenance"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "candidate_type": {"type": "string"},
    "biological_role": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": {"type": ["number", "string", "boolean", "null"]}
    },
    "score": {"type": "number"},
    "rank": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "required": ["datasets"],
      "properties": {
        "datasets": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}},
        "analysis_version": {"type": "string"}
      }
    },
    "validation_status": {"type": "string"},
    "notes": {"type": "string"}
  }
}
